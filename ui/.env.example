# ==============================================================================
# UI Environment Configuration Template (ui/.env.example)
# ==============================================================================

# Backend Service URL (defaults to Docker internal http://backend:8000 in compose, or http://127.0.0.1:8000 in local dev)
BACKEND_URL=http://backend:8000

# Next.js Port and Hostname
PORT=3000
HOSTNAME=0.0.0.0

# Vercel Production Mode
DETERMINISTIC_PROD_MODE=true
NODE_ENV=production

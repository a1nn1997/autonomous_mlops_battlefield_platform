# ==============================================================================
# Root .gitignore - Forecast-to-Insight Autonomous MLOps Platform
# Prevents committing secrets, virtual environments, build artifacts & caches.
# ==============================================================================

# 1. Environment & Secret Files (CRITICAL: Never commit credentials)
.env
.env*
**/.env
**/.env*
!.env.example
!**/.env.example
*.pem
*.key
*.crt
*credential*.json
*service_account*.json
*secret*.json
id_rsa*
id_ed25519*

# 2. Python Virtual Environments (CRITICAL: Never commit .venv)
.venv/
venv/
env/
ENV/
test_env/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. Python Bytecode & Cache Directories
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 4. Node.js & Next.js Build Artifacts
node_modules/
ui/node_modules/
.next/
ui/.next/
ui/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# 5. Vercel Deployment Artifacts
.vercel/
ui/.vercel/

# 6. Media Recordings, Video Logs & Large Artifacts
*.log
*.webp
*.png
*.mp4
models/registry/v_shadow_*/
!models/registry/champion/
!models/registry/v1/
!models/registry/versions.json
!models/registry/.gitkeep

# 7. OS & IDE Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

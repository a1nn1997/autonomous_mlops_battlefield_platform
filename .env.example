# ==============================================================================
# Environment Configuration Template (.env.example)
# Duplicate this file to .env and insert your API keys locally.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# LLM Gateway API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Engine Version Selection: 1=Anthropic Claude, 2=OpenAI, 3=Google Gemini
VERSION=3

# Model Overrides (Ultra-Low Latency Defaults)
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-6-luna
GEMINI_MODEL=gemini-3.8-flash-lite

# Production Token Shield (Set to true in prod to enforce deterministic rule-based mode)
DETERMINISTIC_PROD_MODE=true

# Serving Parameters
PORT=8000
HOST=0.0.0.0
